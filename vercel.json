{
  "buildCommand": "CI=false npm run build",
  "headers": [
    { "source": "/yas-bloom", "headers": [ { "key": "X-Robots-Tag", "value": "noindex" } ] },
    { "source": "/yas-bloom/:path*", "headers": [ { "key": "X-Robots-Tag", "value": "noindex" } ] },
    { "source": "/ar/yas-bloom", "headers": [ { "key": "X-Robots-Tag", "value": "noindex" } ] },
    { "source": "/ar/yas-bloom/:path*", "headers": [ { "key": "X-Robots-Tag", "value": "noindex" } ] }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
