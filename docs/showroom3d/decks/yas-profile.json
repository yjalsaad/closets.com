  "slides": [
    {
      "id": "cover",
      "layout": "hero",
      "accent": "brass",
      "title": {
        "en": "YAS Wood: Profile 2023",
        "ar": "YAS Wood: ملف 2023"
      },
      "lead": {
        "en": "Surfaces and solutions for furniture and interior design.",
        "ar": "أسطح وحلول للأثاث والتصميم الداخلي."
      },
      "bullets": [
        {
          "en": "From the YAS Wood profile supplied by management, condensed for this room.",
          "ar": "من ملف YAS Wood المقدَّم من الإدارة، ومُختصر لهذه الغرفة."
        }
      ],
      "blocks": [
        {
          "type": "image",
          "url": "https://www.the-closets.com/yas-bloom/profile/yas-cover.webp",
          "alt": {
            "en": "A bright room with a light sideboard, from the YAS Wood profile cover",
            "ar": "غرفة مضيئة مع بوفيه فاتح، من غلاف ملف YAS Wood"
          }
        }
      ],
      "source": {
        "en": "YAS Wood Profile 2023, p. 1. Arabic text is a translation awaiting native review.",
        "ar": "ملف YAS Wood لعام 2023، ص 1. النص العربي ترجمة بانتظار مراجعة ناطق أصلي."
      }
    },
    {
      "id": "intro",
      "accent": "brass",
      "title": {
        "en": "Introduction",
        "ar": "مقدمة"
      },
      "lead": {
        "en": "Surfaces and solutions for furniture and interior design.",
        "ar": "أسطح وحلول للأثاث والتصميم الداخلي."
      },
      "bullets": [
        {
          "en": "YAS WOOD describes itself as an innovative leader in surfaces and solutions for furniture and interior design.",
          "ar": "تصف YAS WOOD نفسها بأنها رائدة مبتكرة في الأسطح والحلول للأثاث والتصميم الداخلي."
        },
        {
          "en": "Faced panels, laminates and edges made with the finest raw materials and advanced technologies.",
          "ar": "ألواح مكسوّة ولامينيت وحواف مصنوعة من أجود المواد الخام وبتقنيات متقدمة."
        },
        {
          "en": "Delivering products and services since 2007.",
          "ar": "تقدّم منتجاتها وخدماتها منذ عام 2007."
        },
        {
          "en": "A subsidiary of YAS Holding, with the expertise of its sister company, The Closets.",
          "ar": "شركة تابعة لـ YAS Holding، وتستفيد من خبرة شقيقتها ذا كلوزتس."
        }
      ],
      "blocks": [
        {
          "type": "image",
          "url": "https://www.the-closets.com/yas-bloom/profile/yas-lounge.webp",
          "alt": {
            "en": "A light-oak cabinet by a window",
            "ar": "خزانة من خشب البلوط الفاتح عند نافذة"
          }
        }
      ],
      "source": {
        "en": "YAS Wood Profile 2023, p. 2",
        "ar": "ملف YAS Wood لعام 2023، ص 2"
      }
    },
    {
      "id": "mission-vision",
      "accent": "sage",
      "title": {
        "en": "Mission and vision",
        "ar": "الرسالة والرؤية"
      },
      "bullets": [
        {
          "en": "Mission: to provide innovative surfaces and solutions for the furniture and interior design industries, using prestigious raw materials and advanced technologies, and to keep researching and developing products to exceed clients' expectations.",
          "ar": "الرسالة: تقديم أسطح وحلول مبتكرة لصناعتي الأثاث والتصميم الداخلي باستخدام مواد خام مرموقة وتقنيات متقدمة، ومواصلة البحث والتطوير لتجاوز توقعات العملاء."
        },
        {
          "en": "Vision: to be the leading provider of innovative, high-quality faced panels, laminates and edges in the Middle East and beyond.",
          "ar": "الرؤية: أن نكون المزوّد الرائد للألواح المكسوّة واللامينيت والحواف المبتكرة وعالية الجودة في الشرق الأوسط وخارجه."
        }
      ],
      "blocks": [
        {
          "type": "image",
          "url": "https://www.the-closets.com/yas-bloom/profile/yas-mission.webp",
          "alt": {
            "en": "A light-oak door beside a dark console",
            "ar": "باب من البلوط الفاتح بجانب كونسول داكن"
          }
        }
      ],
      "source": {
        "en": "YAS Wood Profile 2023, p. 3",
        "ar": "ملف YAS Wood لعام 2023، ص 3"
      }
    },
    {
      "id": "product",
      "accent": "brass",
      "title": {
        "en": "The product",
        "ar": "المنتج"
      },
      "lead": {
        "en": "Faced panels and edges, versatile and customizable.",
        "ar": "ألواح مكسوّة وحواف، متعددة الاستخدامات وقابلة للتخصيص."
      },
      "bullets": [
        {
          "en": "Faced panels are wood-based and covered with decorative papers, foil, PP or PET for a durable finish.",
          "ar": "الألواح المكسوّة أساسها خشبي ومغطاة بأوراق زخرفية أو فويل أو PP أو PET لإنتاج تشطيب متين."
        },
        {
          "en": "Designed to be versatile, easy to install and customizable to fit any project.",
          "ar": "مصممة لتكون متعددة الاستخدامات وسهلة التركيب وقابلة للتخصيص لأي مشروع."
        },
        {
          "en": "Suited to a new kitchen, a commercial space or a residential project.",
          "ar": "مناسبة لمطبخ جديد أو مساحة تجارية أو مشروع سكني."
        },
        {
          "en": "A commitment to research and development in technology and design.",
          "ar": "التزام بالبحث والتطوير في التقنية والتصميم."
        }
      ],
      "blocks": [
        {
          "type": "image",
          "url": "https://www.the-closets.com/yas-bloom/profile/yas-vanity.webp",
          "alt": {
            "en": "A dark wood-grain vanity unit",
            "ar": "وحدة مغسلة بسطح خشبي داكن"
          }
        }
      ],
      "source": {
        "en": "YAS Wood Profile 2023, p. 4",
        "ar": "ملف YAS Wood لعام 2023، ص 4"
      }
    },
    {
      "id": "partners",
      "accent": "sage",
      "title": {
        "en": "Partners",
        "ar": "الشركاء"
      },
      "lead": {
        "en": "Decorative paper manufacturers from around the world.",
        "ar": "مصنّعو أوراق زخرفية من حول العالم."
      },
      "bullets": [
        {
          "en": "YAS WOOD partners with the decorative papers manufacturers Interprint Impress and Schattdecor.",
          "ar": "تتعاون YAS WOOD مع مصنّعي الأوراق الزخرفية Interprint Impress وSchattdecor."
        },
        {
          "en": "Access to a library of designs, textures and finishes helps it stay at the forefront of design trends.",
          "ar": "الوصول إلى مكتبة من التصاميم والملمسات والتشطيبات يبقيها في طليعة اتجاهات التصميم."
        },
        {
          "en": "The page shows partner certification documents and a \"formaldehyde-free\" mark.",
          "ar": "تعرض الصفحة وثائق اعتماد للشركاء وعلامة «خالٍ من الفورمالدهيد»."
        }
      ],
      "source": {
        "en": "YAS Wood Profile 2023, p. 5",
        "ar": "ملف YAS Wood لعام 2023، ص 5"
      },
      "blocks": []
